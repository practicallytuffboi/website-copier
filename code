		{
			input = "_external/" + uri.Host.ToLowerInvariant() + "/" + input;
		}
		return input.ToLowerInvariant();
	}

	private static string ComputeRelativeLink(string fromRelPath, string toRelPath)
	{
		if (fromRelPath.Equals(toRelPath, StringComparison.OrdinalIgnoreCase))
		{
			return Path.GetFileName(toRelPath);
		}
		string directoryName = Path.GetDirectoryName(fromRelPath.Replace('/', Path.DirectorySeparatorChar));
		string text = toRelPath.Replace('/', Path.DirectorySeparatorChar);
		if (string.IsNullOrEmpty(directoryName))
		{
			return toRelPath;
		}
		string[] array = directoryName.Split(new char[1] { Path.DirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries);
		string[] array2 = text.Split(new char[1] { Path.DirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries);
		int i = 0;
		for (int num = Math.Min(array.Length, array2.Length); i < num && array[i].Equals(array2[i], StringComparison.OrdinalIgnoreCase); i++)
		{
		}
		StringBuilder stringBuilder = new StringBuilder();
		for (int j = i; j < array.Length; j++)
		{
			stringBuilder.Append("../");
		}
		for (int k = i; k < array2.Length; k++)
		{
			stringBuilder.Append(array2[k]);
			if (k < array2.Length - 1)
			{
				stringBuilder.Append("/");
			}
		}
		return stringBuilder.ToString();
	}

	private static string StripFragment(string url)
	{
		int num = url.IndexOf('#');
		if (num < 0)
		{
			return url;
		}
		return url.Substring(0, num);
	}

	private static string FormatBytes(long bytes)
	{
		string[] array = new string[4] { "b", "kb", "mb", "gb" };
		double num = bytes;
		int num2 = 0;
		while (num >= 1024.0 && num2 < array.Length - 1)
		{
			num2++;
			num /= 1024.0;
		}
		return string.Format("{0:0.##} {1}", num, array[num2]);
	}
