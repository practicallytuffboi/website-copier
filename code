	private void CreateSingleFileBundle(string entryPath, string outBundlePath)
	{
		if (!File.Exists(entryPath))
		{
			return;
		}
		string input = File.ReadAllText(entryPath, Encoding.UTF8);
		string baseDir = Path.GetDirectoryName(entryPath);
		input = Regex.Replace(input, "<link\\b(?=[^>]*?\\brel\\s*=\\s*[\"']?stylesheet[\"']?)(?=[^>]*?\\bhref\\s*=\\s*(?:[\"'](?<href>[^\"'\\s>]+)[\"']|(?<href>[^\"'\\s>]+)))[^>]*?>", (Match m) =>
		{
			string value = m.Groups["href"].Value;
			if (string.IsNullOrEmpty(value) || value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("//"))
			{
				return m.Value;
			}
			try
			{
				string fullPath = Path.GetFullPath(Path.Combine(baseDir, value.Replace('/', Path.DirectorySeparatorChar)));
				if (File.Exists(fullPath))
				{
					string input2 = File.ReadAllText(fullPath, Encoding.UTF8);
					string cssDir = Path.GetDirectoryName(fullPath);
					input2 = CssUrlRegex.Replace(input2, (Match cm) =>
					{
						string text = cm.Groups["val"].Value.Trim('\'', '"', ' ');
						if (text.StartsWith("data:", StringComparison.OrdinalIgnoreCase) || text.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || text.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
						{
							return cm.Value;
						}
						try
						{
							string fullPath2 = Path.GetFullPath(Path.Combine(cssDir, text.Replace('/', Path.DirectorySeparatorChar)));
							if (File.Exists(fullPath2))
							{
								byte[] inArray = File.ReadAllBytes(fullPath2);
								string mimeType = GetMimeType(fullPath2);
								return "url(\"data:" + mimeType + ";base64," + Convert.ToBase64String(inArray) + "\")";
							}
						}
						catch
						{
						}
						return cm.Value;
					});
					return "<style>\n" + input2 + "\n</style>";
				}
			}
			catch
			{
			}
			return m.Value;
		}, RegexOptions.IgnoreCase);
		input = Regex.Replace(input, "<script\\b(?=[^>]*?\\bsrc\\s*=\\s*(?:[\"'](?<src>[^\"'\\s>]+)[\"']|(?<src>[^\"'\\s>]+)))[^>]*?>\\s*</script>", (Match m) =>
		{
			string value = m.Groups["src"].Value;
			if (string.IsNullOrEmpty(value) || value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("//"))
			{
				return m.Value;
			}
			try
			{
				string fullPath = Path.GetFullPath(Path.Combine(baseDir, value.Replace('/', Path.DirectorySeparatorChar)));
				if (File.Exists(fullPath))
				{
					string text = File.ReadAllText(fullPath, Encoding.UTF8);
					return "<script>\n" + text + "\n</script>";
				}
			}
			catch
			{
			}
			return m.Value;
		}, RegexOptions.IgnoreCase);
		input = Regex.Replace(input, "<img\\b(?=[^>]*?\\bsrc\\s*=\\s*(?:[\"'](?<src>[^\"'\\s>]+)[\"']|(?<src>[^\"'\\s>]+)))[^>]*?>", (Match m) =>
		{
			Group obj = m.Groups["src"];
			string value = obj.Value;
			if (string.IsNullOrEmpty(value) || value.StartsWith("data:", StringComparison.OrdinalIgnoreCase) || value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("//"))
			{
				return m.Value;
			}
			try
			{
				string fullPath = Path.GetFullPath(Path.Combine(baseDir, value.Replace('/', Path.DirectorySeparatorChar)));
				if (File.Exists(fullPath))
				{
					byte[] inArray = File.ReadAllBytes(fullPath);
					string mimeType = GetMimeType(fullPath);
					string text = "data:" + mimeType + ";base64," + Convert.ToBase64String(inArray);
					int num = obj.Index - m.Index;
					return m.Value.Substring(0, num) + "\"" + text + "\"" + m.Value.Substring(num + obj.Length);
				}
			}
			catch
			{
			}
			return m.Value;
		}, RegexOptions.IgnoreCase);
		File.WriteAllText(outBundlePath, input, Encoding.UTF8);
	}

	private static string GetMimeType(string path)
	{
		switch (Path.GetExtension(path).ToLowerInvariant())
		{
		case ".png":
			return "image/png";
		case ".jpg":
		case ".jpeg":
			return "image/jpeg";
		case ".gif":
			return "image/gif";
		case ".webp":
			return "image/webp";
		case ".svg":
			return "image/svg+xml";
		case ".ico":
			return "image/x-icon";
		case ".bmp":
			return "image/bmp";
		case ".woff":
			return "font/woff";
		case ".woff2":
			return "font/woff2";
		case ".ttf":
			return "font/ttf";
		case ".eot":
			return "application/vnd.ms-fontobject";
		case ".css":
			return "text/css";
		case ".js":
			return "application/javascript";
		default:
			return "application/octet-stream";
		}
	}

	private string RewriteHtml(string html, string pageUrl, string pageLocalRel)
	{
		Uri baseUri = new Uri(pageUrl);
		html = Regex.Replace(html, "<base\\b[^>]*>", "", RegexOptions.IgnoreCase);
		html = Regex.Replace(html, "<meta\\b[^>]*?http-equiv\\s*=\\s*[\"']?Content-Security-Policy[\"']?[^>]*?>", "", RegexOptions.IgnoreCase);
		html = Regex.Replace(html, "\\s+integrity\\s*=\\s*[\"'][^\"']*[\"']", "", RegexOptions.IgnoreCase);
		html = Regex.Replace(html, "\\s+crossorigin(=[\"'][^\"']*[\"'])?", "", RegexOptions.IgnoreCase);
		html = ScriptTagRegex.Replace(html, (Match m) => IsTracker(m.Value) ? "" : m.Value);
		html = Regex.Replace(html, "<noscript\\b[^>]*?>[\\s\\S]*?</noscript>", (Match m) => IsTracker(m.Value) ? "" : m.Value, RegexOptions.IgnoreCase);
		html = TagRegex.Replace(html, (Match m) =>
		{
			Group obj = m.Groups["val"];
			string text = obj.Value.Trim('\'', '"', ' ', '\t', '\r', '\n').Replace("&amp;", "&");
			if (text.StartsWith("data:", StringComparison.OrdinalIgnoreCase) || text.StartsWith("#") || text.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase))
			{
				return m.Value;
			}
			if (IsTracker(text))
			{
				return "";
			}
			if (text.StartsWith("//"))
			{
				text = baseUri.Scheme + ":" + text;
			}
			Uri result;
			if (Uri.TryCreate(baseUri, text, out result))
			{
				string text2 = StripFragment(result.AbsoluteUri);
				if (IsTracker(text2))
				{
					return "";
				}
				lock (mapLock)
				{
					string value;
					if (urlMap.TryGetValue(text2, out value))
					{
						string text3 = ComputeRelativeLink(pageLocalRel, value);
						int num = obj.Index - m.Index;
						return m.Value.Substring(0, num) + text3 + m.Value.Substring(num + obj.Length);
					}
				}
			}
			return m.Value;
		});
		html = AnchorRegex.Replace(html, (Match m) =>
		{
			Group obj = m.Groups["val"];
			string text = obj.Value.Trim('\'', '"', ' ', '\t', '\r', '\n').Replace("&amp;", "&");
			if (text.StartsWith("data:", StringComparison.OrdinalIgnoreCase) || text.StartsWith("#") || text.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase) || text.StartsWith("tel:", StringComparison.OrdinalIgnoreCase) || text.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase))
			{
				return m.Value;
			}
			if (IsTracker(text))
			{
				return "";
			}
			if (text.StartsWith("//"))
			{
				text = baseUri.Scheme + ":" + text;
			}
			Uri result;
			if (Uri.TryCreate(baseUri, text, out result))
			{
				string text2 = StripFragment(result.AbsoluteUri);
				if (IsTracker(text2))
				{
					return "";
				}
				lock (mapLock)
				{
					string value;
					if (urlMap.TryGetValue(text2, out value))
					{
						string text3 = ComputeRelativeLink(pageLocalRel, value);
						int num = obj.Index - m.Index;
						return m.Value.Substring(0, num) + text3 + m.Value.Substring(num + obj.Length);
					}
				}
			}
			return m.Value;
		});
		return html;
	}

