	private byte[] Fetch(string url, out string finalUrl, out string contentType, out string errReason)
	{
		finalUrl = url;
		contentType = null;
		errReason = "unknown";
		try
		{
			HttpWebRequest httpWebRequest = (HttpWebRequest)WebRequest.Create(url);
			httpWebRequest.UserAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36";
			httpWebRequest.Accept = "*/*";
			httpWebRequest.Headers.Add("Accept-Language", "en-US,en;q=0.9");
			httpWebRequest.Timeout = 20000;
			httpWebRequest.ReadWriteTimeout = 20000;
			httpWebRequest.AllowAutoRedirect = true;
			httpWebRequest.MaximumAutomaticRedirections = 5;
			httpWebRequest.AutomaticDecompression = DecompressionMethods.GZip | DecompressionMethods.Deflate;
			httpWebRequest.Proxy = null;
			httpWebRequest.KeepAlive = true;
			using (HttpWebResponse httpWebResponse = (HttpWebResponse)httpWebRequest.GetResponse())
			{
				finalUrl = httpWebResponse.ResponseUri.AbsoluteUri;
				contentType = httpWebResponse.ContentType;
				using (Stream stream = httpWebResponse.GetResponseStream())
				{
					using (MemoryStream memoryStream = new MemoryStream())
					{
						byte[] array = new byte[32768];
						int count;
						while ((count = stream.Read(array, 0, array.Length)) > 0)
						{
							memoryStream.Write(array, 0, count);
						}
						return memoryStream.ToArray();
					}
				}
			}
		}
		catch (WebException ex)
		{
			HttpWebResponse httpWebResponse2 = ex.Response as HttpWebResponse;
			if (httpWebResponse2 != null)
			{
				errReason = "http " + (int)httpWebResponse2.StatusCode;
			}
			else
			{
				errReason = ex.Status.ToString().ToLowerInvariant();
			}
			return null;
		}
		catch (Exception ex2)
		{
			errReason = ex2.GetType().Name.ToLowerInvariant();
			return null;
		}
	}

