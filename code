	private static bool IsTracker(string str)
	{
		if (string.IsNullOrEmpty(str))
		{
			return false;
		}
		string text = str.ToLowerInvariant();
		if (!text.Contains("google-analytics") && !text.Contains("googletagmanager") && !text.Contains("analytics.js") && !text.Contains("gtag/js") && !text.Contains("gtag(") && !text.Contains("doubleclick.net") && !text.Contains("connect.facebook.net") && !text.Contains("fbevents.js") && !text.Contains("clarity.ms") && !text.Contains("hotjar.com") && !text.Contains("scorecardresearch.com") && !text.Contains("trustwave.com") && !text.Contains("quantserve.com") && !text.Contains("adservice.google") && !text.Contains("googlesyndication") && !text.Contains("statcounter.com") && !text.Contains("histats.com") && !text.Contains("yandex.ru") && !text.Contains("beacon.js"))
		{
			return text.Contains("pixel");
		}
		return true;
	}

	private static bool IsBinaryExtension(string ext)
	{
		if (string.IsNullOrEmpty(ext))
		{
			return false;
		}
		string text = ext.ToLowerInvariant();
		switch (text)
		{
		default:
			return text == ".js";
		case ".jpg":
		case ".jpeg":
		case ".png":
		case ".gif":
		case ".webp":
		case ".svg":
		case ".ico":
		case ".bmp":
		case ".pdf":
		case ".zip":
		case ".tar":
		case ".gz":
