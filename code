		string absolutePath = uri.AbsolutePath;
		if (string.IsNullOrEmpty(absolutePath) || absolutePath == "/")
		{
			return "index.html";
		}
		string input = absolutePath.TrimStart('/');
		input = Regex.Replace(input, "[<>:\"/\\\\|?*=&;\\s]+", "_");
		bool flag = uri.Host.ToLowerInvariant().Equals(baseHost, StringComparison.OrdinalIgnoreCase);
		if (isPage)
		{
			string text = Path.GetExtension(input).ToLowerInvariant();
			if (text != ".html" && text != ".htm")
			{
				input += ".html";
			}
			if (!flag)
			{
				input = "_external/" + uri.Host.ToLowerInvariant() + "/" + input;
